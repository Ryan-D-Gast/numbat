use core::scalar
use core::error

@description("Get the length of a 1-D array")
@example("len([3, 2, 1])")
fn len<A>(xs: Array<A>) -> Scalar

@description("Get the first element of a 1-D array. Yields a runtime error if the array is empty.")
@example("head([3, 2, 1])")
fn head<A>(xs: Array<A>) -> A

@description("Get everything but the first element of a 1-D array. Yields a runtime error if the array is empty.")
@example("tail([3, 2, 1])")
fn tail<A>(xs: Array<A>) -> Array<A>

@description("Prepend an element to a 1-D array")
@example("cons(77, [3, 2, 1])")
fn cons<A>(x: A, xs: Array<A>) -> Array<A>

@description("Append an element to the end of a 1-D array")
@example("cons_end(77, [3, 2, 1])")
fn cons_end<A>(x: A, xs: Array<A>) -> Array<A>

@description("Check if a 1-D array is empty")
@example("is_empty([3, 2, 1])")
@example("is_empty([])")
fn is_empty<A>(xs: Array<A>) -> Bool = xs == []

@description("Concatenate two arrays along the first axis")
@example("vcat([3, 2, 1], [10, 11])")
fn vcat<A>(xs1: Array<A>, xs2: Array<A>) -> Array<A>

@description("Concatenate two arrays along the second axis")
@example("hcat([1, 2; 3, 4], [5; 6])")
fn hcat<A>(xs1: Array<A>, xs2: Array<A>) -> Array<A>

@description("Return the shape of an array")
@example("shape([1, 2; 3, 4])")
fn shape<A>(xs: Array<A>) -> Array<Scalar>

@description("Reshape an array to a new 1D or 2D shape")
@example("reshape([1, 2, 3, 4], [2, 2])")
fn reshape<A>(xs: Array<A>, new_shape: Array<Scalar>) -> Array<A>

@description("Get the first `n` elements of a 1-D array")
@example("take(2, [3, 2, 1, 0])")
fn take<A>(n: Scalar, xs: Array<A>) -> Array<A>

@description("Get everything but the first `n` elements of a 1-D array")
@example("drop(2, [3, 2, 1, 0])")
fn drop<A>(n: Scalar, xs: Array<A>) -> Array<A>

@description("Get the element at index `i` in a 1-D array")
@example("element_at(2, [3, 2, 1, 0])")
fn element_at<A>(i: Scalar, xs: Array<A>) -> A

@description("Index into an array using 1-based coordinates")
@example("([1, 2; 3, 4])[1, 2]")
fn index<A>(xs: Array<A>, indices: Array<Scalar>) -> A

@description("Generate a range of integer numbers from `start` to `end` (inclusive)")
@example("range(2, 12)")
fn range(start: Scalar, end: Scalar) -> Array<Scalar>

@description("Create an array filled with a given value and shape")
@example("fill(0, [2, 3])")
fn fill<A>(value: A, shape: Array<Scalar>) -> Array<A>

@description("Reverse the order of a 1-D array")
@example("reverse([3, 2, 1])")
fn reverse<A>(xs: Array<A>) -> Array<A>

@description("Generate a new 1-D array by applying a function to each element of the input array")
@example("map(sqr, [3, 2, 1])", "Square all elements of a 1-D array.")
fn map<A, B>(f: Fn[(A) -> B], xs: Array<A>) -> Array<B>

@description("Generate a new 1-D array by applying a function to each element of the input array. This function takes two inputs: a variable, and the element of the array.")
@example("map2(contains, 2, [[0], [2], [1, 2], [0, 2, 3], []])", "Returns a 1-D array of bools corresponding to whether the sub-array contains a 2 or not.")
fn map2<A, B, C>(f: Fn[(A, B) -> C], other: A, xs: Array<B>) -> Array<C>


@description("Filter a 1-D array by a predicate")
@example("filter(is_finite, [0, 1e10, NaN, -inf])")
fn filter<A>(p: Fn[(A) -> Bool], xs: Array<A>) -> Array<A>

@description("Fold a function over a 1-D array")
@example("foldl(str_append, \"\", [\"Num\", \"bat\", \"!\"])", "Join an array of strings by folding.")
fn foldl<A, B>(f: Fn[(A, B) -> A], acc: A, xs: Array<B>) -> A

@description("Sort a 1-D array of elements, using the given key function that maps the element to a quantity")
@example("fn negate(x) = -x\nsort_by_key(negate, [701, 313, 9999, 4])","Sort descending by key.")
fn sort_by_key<A, D: Dim>(key: Fn[(A) -> D], xs: Array<A>) -> Array<A>

fn id<T>(x: T) -> T = x

@description("Sort a 1-D array of quantities in ascending order")
@example("sort([3, 2, 7, 8, -4, 0, -5])")
fn sort<D: Dim>(xs: Array<D>) -> Array<D> = sort_by_key(id, xs)

@description("Returns true if the element `x` is in the 1-D array `xs`.")
@example("[3, 2, 7, 8, -4, 0, -5] |> contains(0)")
@example("[3, 2, 7, 8, -4, 0, -5] |> contains(1)")
fn contains<A>(x: A, xs: Array<A>) -> Bool

@description("Remove duplicates from a given 1-D array.")
@example("unique([1, 2, 2, 3, 3, 3])")
fn unique<A>(xs: Array<A>) -> Array<A>

@description("Add an element between each pair of elements in a 1-D array")
@example("intersperse(0, [1, 1, 1, 1])")
fn intersperse<A>(sep: A, xs: Array<A>) -> Array<A>

fn _add(x, y) = x + y # TODO: replace this with a local function once we support them
@description("Sum all elements of a 1-D array")
@example("sum([3 m, 200 cm, 1000 mm])")
fn sum<D: Dim>(xs: Array<D>) -> D = foldl(_add, 0, xs)

# TODO: implement linspace using `map` or similar once we have closures. This is ugly.
fn _linspace_helper(start, end, n_steps, i) =
  if i == n_steps
    then []
    else cons(start + (end - start) * i / (n_steps - 1), _linspace_helper(start, end, n_steps, i + 1))

@description("Generate a 1-D array of `n_steps` evenly spaced numbers from `start` to `end` (inclusive)")
@example("linspace(-5 m, 5 m, 11)")
fn linspace<D: Dim>(start: D, end: D, n_steps: Scalar) -> Array<D> =
  if n_steps <= 1
    then error("Number of steps must be larger than 1")
    else _linspace_helper(start, end, n_steps, 0)

@description("Convert an array of strings into a single string by concatenating them with a separator")
@example("join([\"snake\", \"case\"], \"_\")")
fn join(xs: Array<String>, sep: String) -> String
