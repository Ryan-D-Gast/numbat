use core::strings
use core::arrays
use core::numbers
use core::quantities

# Helper functions for mixed-unit conversions. See units::mixed for more.

fn _zero_length<A: Dim>(val: A) -> A = val * 0 -> val

fn _mixed_unit_list<D: Dim>(val: D, units: Array<D>, acc: Array<D>) -> Array<D> =
  if val == 0
    then vcat(acc, map(_zero_length, units))
    else if len(units) == 1
      then cons_end(val -> head(units), acc)
      else _mixed_unit_list(val - unit_val, tail(units), cons_end(unit_val, acc))
  where unit_val: D =
    if (len(units) > 0)
      then ((val -> head(units)) |> trunc_in(head(units)))
      else error("Unit array cannot be empty")
  
fn _negate<D: Dim>(x: D) = -x

fn _sort_descending<D: Dim>(xs: Array<D>) -> Array<D> = sort_by_key(_negate, xs)

fn _clean_units<D: Dim>(units: Array<D>) -> Array<D> = units |> unique() |> _sort_descending()

fn _unit_list<D: Dim>(units: Array<D>, value: D) -> Array<D> = _mixed_unit_list(value, _clean_units(units), [])
